{
  "name": "morfi-splitter",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "firebase": "^13.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.15.4"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "jest --watch",
    "test:ci": "jest --runInBand",
    "test:rules": "firebase emulators:exec --only firestore --project demo-morfi-splitter \"node --test tests/firestore.rules.test.cjs\"",
    "start:test": "vite --config vite.e2e.config.mjs --mode e2e --host 127.0.0.1",
    "test:browser": "playwright test"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-jest": "^30.5.2",
    "firebase-tools": "^15.33.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "firebase-tools": {
      "chokidar": "^4.0.3"
    },
    "@google-cloud/pubsub": {
      "@opentelemetry/core": "^2.12.0"
    },
    "basic-ftp": "^6.2.3",
    "gaxios": {
      "uuid": "^11.1.1"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.3.2"
    }
  }
}
